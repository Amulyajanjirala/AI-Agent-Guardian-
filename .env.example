# AI Agent Guardian Configuration
APP_NAME="AI Agent Guardian"
APP_ENV=development
DEBUG=True
SECRET_KEY=change_this_to_a_secure_random_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite:///./data/guardian.db

# Server Configuration
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["*"]

# LLM provider selection: mock_v1, nvidia, kimi
LLM_PROVIDER=mock_v1

# Future NVIDIA LLM Integration (Version 2+)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Kimi / Moonshot-compatible API (OpenAI-compatible endpoint)
KIMI_API_KEY=your_kimi_api_key_here
KIMI_MODEL=moonshot-v1-32k
KIMI_BASE_URL=https://api.moonshot.cn/v1
LLM_TIMEOUT_SECONDS=30
